# Input Data
usia_cukup = False  # Usia di bawah batas minimal
lulus_teori = True
lulus_praktek = True
pemegang_sertifikat_mengemudi = True
domisili_sesuai = False

# Model Logika (3 AND, 2 OR)
sim_terbit = usia_cukup and lulus_teori and lulus_praktek
prioritas_layanan = pemegang_sertifikat_mengemudi or domisili_sesuai

# Output
if sim_terbit:
    print("SIM dapat DITERBITKAN")
else:
    print("SIM TIDAK DAPAT diterbitkan")

if prioritas_layanan:
    print("Pemohon mendapat PRIORITAS jalur cepat")
else:
    print("Pemohon memproses di jalur standar")
