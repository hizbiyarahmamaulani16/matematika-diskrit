# Input Data
fisik_prima = True
bebas_dopping = False  # Terindikasi doping
lolos_kualifikasi = True
juara_kejurnas = True
rekor_dunia = True

# Model Logika (3 AND, 2 OR)
masuk_timnas = fisik_prima and bebas_dopping and lolos_kualifikasi
prioritas_kapten = juara_kejurnas or rekor_dunia

# Output
if masuk_timnas:
    print("Atlet MASUK skuad Timnas")
else:
    print("Atlet TIDAK MASUK skuad Timnas")

if prioritas_kapten:
    print("Atlet mendapat PRIORITAS posisi Kapten Tim")
else:
    print("Atlet menjadi anggota biasa")
