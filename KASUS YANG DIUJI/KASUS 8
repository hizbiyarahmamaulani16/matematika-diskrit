# Input Data
kuota_tersedia = False  # Kuota pendaftaran sudah penuh
bayar_dp = False
produk_legal = False
sponsor_utama = False
brand_viral = False

# Model Logika (3 AND, 2 OR)
tenant_diterima = kuota_tersedia and bayar_dp and produk_legal
prioritas_lokasi_strategis = sponsor_utama or brand_viral

# Output
if tenant_diterima:
    print("Tenant DITERIMA mengisi booth")
else:
    print("Tenant TIDAK DITERIMA mengisi booth")

if prioritas_lokasi_strategis:
    print("Tenant mendapat PRIORITAS lokasi depan")
else:
    print("Tenant mendapat lokasi acak")
