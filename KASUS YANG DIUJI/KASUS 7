# Input Data
polis_aktif = True
penyakit_dicover = False  # Jenis penyakit di luar pertanggungan
bebas_fraud = True
rawat_inap_icu = False
sertifikat_rujukan = True

# Model Logika (3 AND, 2 OR)
klaim_cair = polis_aktif and penyakit_dicover and bebas_fraud
prioritas_pembayaran = rawat_inap_icu or sertifikat_rujukan

# Output
if klaim_cair:
    print("Klaim asuransi DISETUJUI")
else:
    print("Klaim asuransi DITOLAK")

if prioritas_pembayaran:
    print("Klaim mendapat PRIORITAS pemrosesan instan")
else:
    print("Klaim diproses dalam jangka waktu standar")
