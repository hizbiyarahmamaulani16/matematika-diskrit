# Input Data
gaji_cukup = True
bi_checking_bersih = True
dokumen_lengkap = True
agunan_tambahan = True
nasabah_prioritas = False

# Model Logika (3 AND, 2 OR)
kpr_disetujui = gaji_cukup and bi_checking_bersih and dokumen_lengkap
prioritas_bunga_rendah = agunan_tambahan or nasabah_prioritas

# Output
if kpr_disetujui:
    print("Pengajuan KPR DISETUJUI")
else:
    print("Pengajuan KPR DITOLAK")

if prioritas_bunga_rendah:
    print("Nasabah mendapat PRIORITAS bunga spesial")
else:
    print("Nasabah mendapatkan bunga standar")
