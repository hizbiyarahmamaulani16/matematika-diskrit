def cek_persetujuan_cuti(masa_kerja_tahun, sisa_cuti):
    # Syarat 1: Masa kerja minimal 1 tahun
    # Syarat 2: Sisa cuti masih ada (> 0)
    syarat_masa_kerja = masa_kerja_tahun >= 1
    syarat_jatah_cuti = sisa_cuti > 0
    
    return syarat_masa_kerja and syarat_jatah_cuti

# Contoh Penggunaan:
karyawan_a = cek_persetujuan_cuti(masa_kerja_tahun=2, sisa_cuti=5)
print(f"Karyawan A (2 tahun kerja, sisa cuti 5): {karyawan_a}") # Output: True

karyawan_b = cek_persetujuan_cuti(masa_kerja_tahun=0.5, sisa_cuti=10)
print(f"Karyawan B (6 bulan kerja, sisa cuti 10): {karyawan_b}") # Output: False (masa kerja kurang)
