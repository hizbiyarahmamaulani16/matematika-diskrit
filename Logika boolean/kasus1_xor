def cek_status_kehadiran(pilih_wfh, pilih_wfo):
    # Hanya boleh pilih salah satu: WFH saja atau WFO saja
    # True jika salah satu dipilih, False jika tidak mendaftar atau mendaftar keduanya
    return pilih_wfh ^ pilih_wfo

# Contoh Penggunaan:
karyawan_a = cek_status_kehadiran(pilih_wfh=True, pilih_wfo=False)
print(f"Karyawan A (Hanya WFH): {karyawan_a}") # Output: True (Valid)

karyawan_b = cek_status_kehadiran(pilih_wfh=True, pilih_wfo=True)
print(f"Karyawan B (Pilih WFH & WFO sekaligus): {karyawan_b}") # Output: False (Konflik)

karyawan_c = cek_status_kehadiran(pilih_wfh=False, pilih_wfo=False)
print(f"Karyawan C (Tidak memilih keduanya): {karyawan_c}") # Output: False (Tidak terdaftar)
