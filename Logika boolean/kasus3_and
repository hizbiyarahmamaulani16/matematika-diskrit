def cek_akses_server(apakah_admin, terhubung_vpn):
    # Syarat 1: Harus berstatus admin
    # Syarat 2: Harus menggunakan VPN perusahaan
    return apakah_admin and terhubung_vpn

# Contoh Penggunaan:
user_1 = cek_akses_server(apakah_admin=True, terhubung_vpn=True)
print(f"User 1 (Admin & Pakai VPN): {user_1}") # Output: True

user_2 = cek_akses_server(apakah_admin=True, terhubung_vpn=False)
print(f"User 2 (Admin tapi Tidak Pakai VPN): {user_2}") # Output: False (tidak lewat VPN aman)
