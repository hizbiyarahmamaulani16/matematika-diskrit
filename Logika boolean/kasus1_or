def cek_kualifikasi_pelamar(punya_ijazah_s1, pengalaman_tahun):
    # Syarat 1: Lulusan S1
    # Syarat 2: Pengalaman kerja minimal 3 tahun
    kualifikasi_pendidikan = punya_ijazah_s1
    kualifikasi_pengalaman = pengalaman_tahun >= 3
    
    return kualifikasi_pendidikan or kualifikasi_pengalaman

# Contoh Penggunaan:
pelamar_1 = cek_kualifikasi_pelamar(punya_ijazah_s1=True, pengalaman_tahun=0)
print(f"Pelamar 1 (S1 Fresh Graduate): {pelamar_1}") # Output: True

pelamar_2 = cek_kualifikasi_pelamar(punya_ijazah_s1=False, pengalaman_tahun=5)
print(f"Pelamar 2 (Non-S1, Pengalaman 5 tahun): {pelamar_2}") # Output: True

pelamar_3 = cek_kualifikasi_pelamar(punya_ijazah_s1=False, pengalaman_tahun=1)
print(f"Pelamar 3 (Non-S1, Pengalaman 1 tahun): {pelamar_3}") # Output: False
