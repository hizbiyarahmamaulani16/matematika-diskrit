def cek_kelayakan_bonus(kpi_tercapai, tingkat_kehadiran_persen):
    # Syarat 1: KPI minimal 85%
    # Syarat 2: Kehadiran minimal 95%
    target_kpi = kpi_tercapai >= 85
    target_absen = tingkat_kehadiran_persen >= 95
    
    return target_kpi and target_absen

# Contoh Penggunaan:
pekerja_1 = cek_kelayakan_bonus(kpi_tercapai=90, tingkat_kehadiran_persen=98)
print(f"Pekerja 1 (KPI 90, Hadir 98%): {pekerja_1}") # Output: True

pekerja_2 = cek_kelayakan_bonus(kpi_tercapai=88, tingkat_kehadiran_persen=90)
print(f"Pekerja 2 (KPI 88, Hadir 90%): {pekerja_2}") # Output: False (kehadiran kurang)
