def cek_status_peringatan(beban_cpu_persen, sisa_ram_persen):
    # Syarat 1: Beban CPU di atas 90%
    # Syarat 2: Sisa RAM di bawah 10%
    cpu_kritis = beban_cpu_persen > 90
    ram_kritis = sisa_ram_persen < 10
    
    return cpu_kritis or ram_kritis

# Contoh Penggunaan:
server_a = cek_status_peringatan(beban_cpu_persen=95, sisa_ram_persen=40)
print(f"Server A (CPU 95%, RAM Sisa 40%): {server_a}") # Output: True (CPU Kritis)

server_b = cek_status_peringatan(beban_cpu_persen=50, sisa_ram_persen=5)
print(f"Server B (CPU 50%, RAM Sisa 5%): {server_b}") # Output: True (RAM Kritis)

server_c = cek_status_peringatan(beban_cpu_persen=40, sisa_ram_persen=60)
print(f"Server C (CPU 40%, RAM Sisa 60%): {server_c}") # Output: False (Semua normal)
